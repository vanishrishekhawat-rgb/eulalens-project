PORT=5050
HOST=127.0.0.1
MOCK_MODE=false
PRESENTATION_MODE=true
PRESENTATION_PRECOMPUTED_ROOT=public/precomputed_data
MAX_ANALYZE_PAYLOAD_MB=25

# Presentation mode serves known user-study EULAs from precomputed assets, then falls through to Qwen.
# Qwen OpenAI-compatible endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=qwen3.5-9b
QWEN_CHUNK_CHARS=7000
QWEN_MAX_TOKENS=2400
QWEN_CARD_MAX_TOKENS=1200
QWEN_CARD_BATCH_CONCURRENCY=3
QWEN_COMIC_SCRIPT_MAX_TOKENS=5600
QWEN_VIDEO_SCRIPT_MAX_TOKENS=1800
QWEN_VIDEO_DURATION_SECONDS=30
QWEN_DEBUG_OUTPUT=false

# Browser-side comic preloading queue. Keep small for one local vLLM GPU.
VITE_CARD_PRELOAD_BATCH_SIZE=3
VITE_COMIC_PRELOAD_CONCURRENCY=2
VITE_VIDEO_SCRIPT_PRELOAD_CONCURRENCY=1

# HiDream comic image service.
HIDREAM_IMAGE_API_URL=http://localhost:5052
HIDREAM_API_KEY=
HIDREAM_IMAGE_TIMEOUT_MS=900000

# Backward-compatible DashScope names still work if QWEN_* is unset.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Generic video provider. Use the local LTX service for local demos.
VIDEO_PROVIDER=ltx-local
VIDEO_API_KEY=
VIDEO_API_URL=http://localhost:5054/generate
VIDEO_MODEL=
VIDEO_DURATION_SECONDS=30
VIDEO_ASPECT_RATIO=16:9
VIDEO_STATUS_URL_TEMPLATE=
